{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "dayunhalawa-mcp": {
      "type": "local",
      "enabled": true,
      "command": [
        "/absolute/path/to/DayunHalawa-MCP/.venv/bin/python",
        "-m",
        "dayunhalawa_mcp"
      ],
      "environment": {
        "DAYUNHALAWA_INDEX_DIR": "/absolute/path/to/DayunHalawa-MCP/index",
        "HF_HUB_OFFLINE": "1",
        "TRANSFORMERS_OFFLINE": "1"
      }
    }
  }
}

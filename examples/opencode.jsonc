{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "rift": {
      "type": "local",
      "enabled": true,
      "command": [
        "/absolute/path/to/RIFT/.venv/bin/python",
        "-m",
        "rift_mcp"
      ],
      "environment": {
        "RIFT_INDEX_DIR": "/absolute/path/to/RIFT/index",
        "HF_HUB_OFFLINE": "1",
        "TRANSFORMERS_OFFLINE": "1"
      }
    }
  }
}
